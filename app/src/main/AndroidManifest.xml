<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest of a locked-down WebView wrapper.

  Notes for reviewers:
  * Exactly one component (the launcher activity) and exactly one intent filter. No services, no
    receivers, no providers, no exported helpers that another app could drive.
  * No deep-link filters: the app cannot be steered to an arbitrary URL from outside.
  * allowBackup=false so cookies/session data cannot be extracted through adb backup.
  * usesCleartextTraffic=false plus a network security config that trusts only system CAs: the app can
    only talk HTTPS, and a user-installed proxy CA cannot intercept it.
  * No storage / camera / location / contacts permissions are declared at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.GitHubWebViewLocked">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale|navigation"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
